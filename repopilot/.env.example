# Core settings
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repopilot

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# GitHub (optional)
GITHUB_TOKEN=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
MAX_CONCURRENT_LLM_CALLS=10
MAX_SANDBOX_EXECUTIONS=5

# Sandbox
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512m

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
